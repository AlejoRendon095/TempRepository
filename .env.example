# Puerto HTTP de la API
PORT=3000

# Base de datos (PostgreSQL). Con docker compose, DB_HOST=localhost desde tu máquina.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=moderation

# Umbrales del motor de decisión (0..1)
BLOCK_THRESHOLD=0.85
PUBLISH_THRESHOLD=0.85

# Clasificador: "llm" (Gemini) o "rules" (offline, sin API key)
CLASSIFIER_MODE=rules

# Google Gemini. API key gratis en https://aistudio.google.com/apikey
# Sin API key, en modo llm todo va a revisión humana.
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Timeout por intento (ms, mínimo 10000: Gemini rechaza plazos menores) y reintentos
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=2
# Segundos que se reutiliza la clasificación de un texto repetido
CLASSIFIER_CACHE_TTL=300

# Rate limiting
# Envíos a POST /comments: THROTTLE_LIMIT por ventana de THROTTLE_TTL segundos, por IP y por userId
THROTTLE_TTL=60
THROTTLE_LIMIT=10
# Resto de rutas: peticiones por minuto por IP
THROTTLE_GLOBAL_LIMIT=60
# Número de proxies de confianza (ej. 1 detrás de nginx). Vacío si no hay proxy.
TRUST_PROXY=

# JWT (obligatorio, sin valor por defecto)
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_ROUNDS=12

# 2FA TOTP (obligatorio si se usa 2FA)
TOTP_ENCRYPTION_KEY=

# Seed (obligatorio para npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: SEED_MODERATOR_EMAIL, SEED_MODERATOR_PASSWORD, SEED_DEMO_EMAIL, SEED_DEMO_PASSWORD
